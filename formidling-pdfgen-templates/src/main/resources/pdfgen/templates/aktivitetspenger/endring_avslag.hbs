{{#> felles/base}}

    {{#> felles/seksjon/hoved }}
        <h1>Nav har endret aktivitetspengene dine</h1>

        {{#with bosted}}
            {{#eq årsak "YTELSE_IKKE_TILGJENGELIG_PÅ_BOSTED"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi du ikke har bostedsadresse i Trondheim kommune i denne perioden, får du ikke aktivitetspenger.
                </p>
            {{else eq årsak "YTELSE_IKKE_PÅ_ARBEIDSSTED_STUDIESTED"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi studie- eller arbeidsstedet ditt ligger utenfor Trondheim kommune i denne perioden, får du ikke aktivitetspenger.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}
        {{/with}}

        {{#with bistand}}
            {{#eq årsak "HAR_IKKE_14A_VEDTAK"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    For å ha rett på aktivitetspenger må du ha et oppfølgingsvedtak etter NAV-loven § 14a.
                    Fordi du ikke har et slikt vedtak i denne perioden, får du ikke aktivitetspenger.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}
        {{/with}}

        {{#with andreLivsoppholdsytelser}}
            {{#if ytelseNavn}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    Det er fordi du får {{ytelseNavn}} i denne perioden.
                    Du kan ikke få aktivitetspenger samtidig som du får en annen livsoppholdsytelse.
                </p>
            {{/if}}
            {{#eq årsak "MOTTAR_ANNEN_YTELSE"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    Det er fordi du får en annen livsoppholdsytelse i denne perioden.
                    Du kan ikke få aktivitetspenger samtidig.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}
        {{/with}}

    {{/felles/seksjon/hoved}}

    {{> aktivitetspenger/footer/footer-vedtak }}

{{/felles/base}}
