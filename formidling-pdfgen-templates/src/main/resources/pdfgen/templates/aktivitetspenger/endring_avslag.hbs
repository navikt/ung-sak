{{#> felles/base}}

    {{#> felles/seksjon/hoved }}
        <h1>Nav har endret aktivitetspengene dine</h1>

        {{#with bosted}}
            {{#eq årsak "YTELSE_IKKE_TILGJENGELIG_PÅ_BOSTED"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi du ikke har bostedsadresse i Trondheim kommune i denne perioden, får du ikke aktivitetspenger.
                </p>
            {{else eq årsak "YTELSE_IKKE_PÅ_ARBEIDSSTED_STUDIESTED"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi du i denne perioden bor der du studerer eller jobber, utenfor Trondheim kommune, regner vi deg ikke som bosatt i kommunen.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}

            {{> aktivitetspenger/footer/hjemmel paragraf="2"}}
        {{/with}}

        {{#with bistand}}
            {{#eq årsak "KOMMET_I_ARBEID"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å få eller beholde en jobb. Fordi du jobber i perioden og ikke trenger slik hjelp, stanser vi aktivitetspengene dine.
                </p>
            {{else eq årsak "KOMMET_I_UTDANNING"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    Du kan bare få aktivitetspenger mens du tar høyere utdanning hvis utdanningen er et arbeidsmarkedstiltak fra Nav. Fordi du i denne perioden tar høyere utdanning som ikke er et arbeidsmarkedstiltak, stanser vi aktivitetspengene dine.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å få eller beholde en jobb.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}

            {{#eq årsak "KOMMET_I_UTDANNING"}}
                {{> aktivitetspenger/footer/hjemmel paragraf="7"}}
            {{else}}
                {{> aktivitetspenger/footer/hjemmel paragraf="6"}}
            {{/eq}}
        {{/with}}

        {{#with andreLivsoppholdsytelser}}
            {{#if ytelseNavn}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    Det er fordi du får {{ytelseNavn}} i denne perioden.
                    Du kan ikke få aktivitetspenger samtidig som du får denne ytelsen.
                </p>
            {{/if}}
            {{#eq årsak "MOTTAR_ANNEN_YTELSE"}}
                <p>
                    Du får ikke aktivitetspenger i perioden fra {{periode.fom}} til {{periode.tom}}.
                    Det er fordi du får en annen livsoppholdsytelse i denne perioden.
                    Du kan ikke få aktivitetspenger samtidig.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}

            {{> aktivitetspenger/footer/hjemmel paragraf="4"}}
        {{/with}}

    {{/felles/seksjon/hoved}}

    {{> aktivitetspenger/footer/footer-vedtak }}

{{/felles/base}}
