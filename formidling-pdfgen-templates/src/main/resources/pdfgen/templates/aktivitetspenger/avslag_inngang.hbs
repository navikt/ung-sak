{{#> felles/base}}

    {{#> felles/seksjon/hoved }}
        <h1>Vi har avslått din søknad om aktivitetspenger</h1>

        {{#with bosted}}
            {{#eq årsak "YTELSE_IKKE_TILGJENGELIG_PÅ_BOSTED"}}
                <p>
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi du ikke har bostedsadresse i Trondheim kommune, har vi avslått søknaden din.
                </p>
            {{else eq årsak "YTELSE_IKKE_PÅ_ARBEIDSSTED_STUDIESTED"}}
                <p>
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi studie- eller arbeidsstedet ditt er utenfor Trondheim kommune, har vi avslått søknaden din.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
                <p>
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}
        {{/with}}

        {{#with bistand}}
            {{#eq årsak "KOMMET_I_ARBEID"}}
                <p>
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å komme i jobb eller utdanning. Fordi du er i jobb, har vi avslått søknaden din.
                </p>
            {{else eq årsak "KOMMET_I_UTDANNING"}}
                <p>
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å komme i jobb eller utdanning. Fordi du tar en utdanning, har vi avslått søknaden din.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}
        {{/with}}

        {{#with andreLivsoppholdsytelser}}
            <p>
                Du har ikke rett til aktivitetspenger fordi du får {{ytelseNavn}}. Du kan ikke få aktivitetspenger
                samtidig som du får en annen livsoppholdsytelse.
                {{#unless fritekstBrev}}
                    Derfor har vi avslått søknaden din.
                {{/unless}}
            </p>
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
                <p>
                    Derfor har vi avslått søknaden din.
                </p>
            {{/if}}
        {{/with}}

    {{/felles/seksjon/hoved}}

    {{> aktivitetspenger/footer/footer-vedtak }}

{{/felles/base}}
