{{#> felles/base}}

    {{#> felles/seksjon/hoved }}
        <h1>Vi har avslått din søknad om aktivitetspenger</h1>

        {{#with bosted}}
            {{#eq årsak "YTELSE_IKKE_TILGJENGELIG_PÅ_BOSTED"}}
                <p>
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi du ikke har bostedsadresse i Trondheim kommune, har vi avslått søknaden din.
                </p>
            {{else eq årsak "YTELSE_IKKE_PÅ_ARBEIDSSTED_STUDIESTED"}}
                <p>
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi du bor der du studerer eller jobber, utenfor Trondheim kommune, regner vi deg ikke som bosatt i kommunen.
                    Derfor har vi avslått søknaden din.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
                <p>
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}

            {{> aktivitetspenger/footer/hjemmel paragraf="2"}}
        {{/with}}

        {{#with bistand}}
            {{#eq årsak "KOMMET_I_ARBEID"}}
                <p>
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å få eller beholde en jobb. Fordi du er i jobb og ikke trenger slik hjelp, har vi avslått søknaden din.
                </p>
            {{else eq årsak "KOMMET_I_UTDANNING"}}
                <p>
                    Du kan bare få aktivitetspenger mens du tar høyere utdanning hvis utdanningen er et arbeidsmarkedstiltak fra Nav. Fordi du tar høyere utdanning som ikke er et arbeidsmarkedstiltak, har vi avslått søknaden din.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
                <p>
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å få eller beholde en jobb. Fordi du ikke har behov for denne hjelpen fra Nav, har vi avslått søknaden din.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}

            {{#eq årsak "KOMMET_I_UTDANNING"}}
                {{> aktivitetspenger/footer/hjemmel paragraf="7"}}
            {{else}}
                {{> aktivitetspenger/footer/hjemmel paragraf="6"}}
            {{/eq}}
        {{/with}}

        {{#with andreLivsoppholdsytelser}}
            <p>
                Du har ikke rett til aktivitetspenger fordi du får {{ytelseNavn}}. Du kan ikke få aktivitetspenger
                samtidig som du får denne ytelsen.
                {{#unless fritekstBrev}}
                    Derfor har vi avslått søknaden din.
                {{/unless}}
            </p>
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
                <p>
                    Derfor har vi avslått søknaden din.
                </p>
            {{/if}}

            {{> aktivitetspenger/footer/hjemmel paragraf="4"}}
        {{/with}}

        {{#with medlemskap}}
        <p>
            Du har ikke rett til aktivitetspenger. For å ha rett til aktivitetspenger må du ha vært medlem i folketrygden de siste fem årene før {{fom}}.
            Fordi du ikke har vært medlem av folketrygden de siste fem årene, har vi avslått søknaden din.
        </p>
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}
        {{/with}}

    {{/felles/seksjon/hoved}}

    {{> aktivitetspenger/footer/footer-vedtak }}

{{/felles/base}}
