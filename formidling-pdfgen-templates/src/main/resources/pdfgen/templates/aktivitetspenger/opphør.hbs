{{#> felles/base}}

    {{#> felles/seksjon/hoved }}
        <h1>Du får ikke lenger aktivitetspenger</h1>

        {{#with bosted}}
            {{#eq årsak "YTELSE_IKKE_TILGJENGELIG_PÅ_BOSTED"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi du ikke lenger har bostedsadresse i Trondheim kommune, får du ikke lenger aktivitetspenger.
                </p>
            {{else eq årsak "YTELSE_IKKE_PÅ_ARBEIDSSTED_STUDIESTED"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi studie- eller arbeidsstedet ditt ligger utenfor Trondheim kommune, får du ikke lenger aktivitetspenger.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}
        {{/with}}

        {{#with bistand}}
            {{#eq årsak "KOMMET_I_ARBEID"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å få jobb eller utdanning. Fordi du nå har begynt å jobbe, stanser vi aktivitetspengene dine.
                </p>
            {{else eq årsak "KOMMET_I_UTDANNING"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å få jobb eller utdanning. Fordi du nå har begynt på en utdanning, stanser vi aktivitetspengene dine.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å få jobb eller utdanning.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}
        {{/with}}

        {{#with andreLivsoppholdsytelser}}
            {{#if ytelseNavn}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    Det er fordi du får {{ytelseNavn}} fra denne datoen.
                    Du kan ikke få aktivitetspenger samtidig som du får en annen livsoppholdsytelse.
                </p>
            {{/if}}
            {{#eq årsak "MOTTAR_ANNEN_YTELSE"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    Det er fordi du får en annen livsoppholdsytelse fra denne datoen.
                    Du kan ikke få aktivitetspenger samtidig.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}
        {{/with}}

    {{/felles/seksjon/hoved}}

    {{> aktivitetspenger/footer/footer-vedtak }}

{{/felles/base}}
