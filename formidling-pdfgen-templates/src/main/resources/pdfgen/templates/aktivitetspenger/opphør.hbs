{{#> felles/base}}

    {{#> felles/seksjon/hoved }}
        <h1>Du får ikke lenger aktivitetspenger</h1>

        {{#with bosted}}
            {{#eq årsak "YTELSE_IKKE_TILGJENGELIG_PÅ_BOSTED"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi du ikke lenger har bostedsadresse i Trondheim kommune, får du ikke lenger aktivitetspenger.
                </p>
            {{else eq årsak "YTELSE_IKKE_PÅ_ARBEIDSSTED_STUDIESTED"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                    Fordi studie- eller arbeidsstedet ditt ligger utenfor Trondheim kommune, regner vi deg ikke lenger som bosatt i kommunen.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du bo i Trondheim kommune.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}

            {{> aktivitetspenger/footer/hjemmel paragraf="2"}}
        {{/with}}

        {{#with bistand}}
            {{#eq årsak "KOMMET_I_ARBEID"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å få eller beholde en jobb. Fordi du nå har begynt å jobbe og ikke lenger trenger slik hjelp, stanser vi aktivitetspengene dine.
                </p>
            {{else eq årsak "KOMMET_I_UTDANNING"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    Du kan bare få aktivitetspenger mens du tar høyere utdanning hvis utdanningen er et arbeidsmarkedstiltak fra Nav. Fordi du har begynt på høyere utdanning som ikke er et arbeidsmarkedstiltak, stanser vi aktivitetspengene dine.
                </p>
            {{else eq årsak "ANNEN_ÅRSAK"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    For å ha rett til aktivitetspenger må du ha behov for hjelp fra Nav til å få eller beholde en jobb.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}

            {{#eq årsak "KOMMET_I_UTDANNING"}}
                {{> aktivitetspenger/footer/hjemmel paragraf="7"}}
            {{else}}
                {{> aktivitetspenger/footer/hjemmel paragraf="6"}}
            {{/eq}}
        {{/with}}

        {{#with andreLivsoppholdsytelser}}
            {{#if ytelseNavn}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    Det er fordi du får {{ytelseNavn}} fra denne datoen.
                    Du kan ikke få aktivitetspenger samtidig som du får denne ytelsen.
                </p>
            {{/if}}
            {{#eq årsak "MOTTAR_ANNEN_YTELSE"}}
                <p>
                    Fra {{periode.fom}} får du ikke lenger aktivitetspenger.
                    Det er fordi du får en annen livsoppholdsytelse fra denne datoen.
                    Du kan ikke få aktivitetspenger samtidig.
                </p>
            {{/eq}}
            {{#if fritekstBrev}}
                <p>
                    {{fritekstBrev}}
                </p>
            {{/if}}

            {{> aktivitetspenger/footer/hjemmel paragraf="4"}}
        {{/with}}

    {{/felles/seksjon/hoved}}

    {{> aktivitetspenger/footer/footer-vedtak }}

{{/felles/base}}
